# Public values from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Server-only key from Settings > API Keys. Required for catalogue inventory,
# guest carts, checkout, orders and payment finalization. Never expose it with
# NEXT_PUBLIC_ or commit it to source control.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Razorpay public key may be sent to Checkout; both secrets remain server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
