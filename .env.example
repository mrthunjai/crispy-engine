# Public values used for catalogue reads and future Supabase Auth clients.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only. Required for guest cart routes; never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Razorpay public key may be sent to Checkout; both secrets remain server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
